<UserControl
    x:Class="Panex.Controls.IncludedInteractionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock
            Text="{x:Bind LabelText, Mode=OneWay}"
            Visibility="{x:Bind HasLabelText, Mode=OneWay}"
            VerticalAlignment="Center"
            Margin="0,0,12,0" />

        <Button
            Padding="10,5"
            Background="Transparent"
            BorderThickness="1"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="12" />
                <TextBlock Text="Included Interactions" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="6" MinWidth="220">
                        <TextBlock Text="{x:Bind FlyoutTitle, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox Content="Photoelectric Absorption" IsChecked="{Binding DepthIncludePhotoelectric, Mode=TwoWay}" />
                        <CheckBox Content="Coherent Scattering (Rayleigh)" IsChecked="{Binding DepthIncludeCoherent, Mode=TwoWay}" />
                        <CheckBox Content="Incoherent Scattering (Compton)" IsChecked="{Binding DepthIncludeIncoherent, Mode=TwoWay}" />
                        <CheckBox Content="Pair Production (Nuclear)" IsChecked="{Binding DepthIncludePair, Mode=TwoWay}" />
                        <CheckBox Content="Pair Production (Electron)" IsChecked="{Binding DepthIncludeTriplet, Mode=TwoWay}" />
                        <CheckBox Content="Photonuclear Absorption" IsChecked="{Binding DepthIncludePhotonuclear, Mode=TwoWay}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
