<UserControl
    x:Class="Panex.Controls.PhysicsDataTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panex="using:Panex"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <panex:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <panex:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,12"
                Visibility="{x:Bind ShowEnergyGridConfig, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Energy Grid Configuration" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton
                    Content="Natural Physics Grid (Collated)"
                    IsChecked="{Binding IsUserGrid, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                    Margin="0,0,0,6" />
                <RadioButton
                    Content="User Defined Energies (MeV)"
                    IsChecked="{Binding IsUserGrid, Mode=TwoWay}" />
                <TextBox
                    Text="{Binding UserGridInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding IsUserGrid}"
                    Height="60"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Margin="24,6,0,8"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                SelectionMode="None"
                ShowsScrollingPlaceholders="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,2" />
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ListViewItemPresenter
                                        ContentMargin="{TemplateBinding Padding}"
                                        SelectedBackground="Transparent"
                                        PointerOverBackground="Transparent"
                                        PressedBackground="Transparent" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Header>
                    <Border
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8"
                        Background="{ThemeResource LayerFillColorAltBrush}">
                        <ItemsRepeater x:Name="HeaderRepeater" ItemsSource="{x:Bind HeadersSource, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Title}"
                                        Width="{Binding Width}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ItemsRepeater ItemsSource="{Binding Values}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding}"
                                        Width="180"
                                        FontFamily="Consolas"
                                        VerticalAlignment="Center" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                Grid.Row="2"
                Command="{x:Bind CopyCommand, Mode=OneWay}"
                Margin="0,12,0,0"
                Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                    <TextBlock Text="Copy to Clipboard" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
