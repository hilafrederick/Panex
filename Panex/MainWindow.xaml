<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="Panex.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    xmlns:local="using:Panex"
    xmlns:converters="using:Panex.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="using:ScottPlot.WinUI"
    xmlns:vm="using:Panex.ViewModels"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:layout="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls="using:Panex.Controls"
    mc:Ignorable="d"
    Title="Panex">

    <winuiex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winuiex:WindowEx.SystemBackdrop>

    <Grid x:Name="RootGrid" MinWidth="1280" MinHeight="720" KeyDown="RootGrid_KeyDown" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.DataContext>
            <vm:MainViewModel/>
        </Grid.DataContext>

        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>
            <local:BuildupFactorTypeToBoolConverter x:Key="BuildupFactorTypeToBoolConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter"/>

            <!-- Fluent Segmented Pill RadioButton Style -->
            <Style x:Key="SegmentedPillRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="RootElement" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CheckedBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="HoverBackground"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"/>

                                <Border x:Name="CheckedBackground"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"/>

                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Storyboard x:Key="OpenDrawerLoad" Completed="OpenDrawerStoryboard_Completed">
                <DoubleAnimation x:Name="OpenDrawerLoadWidthAnim" EnableDependentAnimation="True" Storyboard.TargetName="CreateDrawer" Storyboard.TargetProperty="Width" To="820" Duration="0:0:0.32">
                    <DoubleAnimation.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="DrawerContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" BeginTime="0:0:0.08"/>
                <DoubleAnimation Storyboard.TargetName="DrawerScrim" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.3"/>
            </Storyboard>

            <Storyboard x:Key="OpenDrawerNew" Completed="OpenDrawerStoryboard_Completed">
                <DoubleAnimation x:Name="OpenDrawerNewWidthAnim" EnableDependentAnimation="True" Storyboard.TargetName="CreateDrawer" Storyboard.TargetProperty="Width" To="820" Duration="0:0:0.32">
                    <DoubleAnimation.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="DrawerContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" BeginTime="0:0:0.08"/>
                <DoubleAnimation Storyboard.TargetName="DrawerScrim" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.3"/>
            </Storyboard>

            <Storyboard x:Key="CloseDrawer" Completed="CloseDrawerStoryboard_Completed">
                <DoubleAnimation EnableDependentAnimation="True" Storyboard.TargetName="CreateDrawer" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="DrawerContent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="DrawerScrim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modernized TitleBar with Active Database Selector & Theme Toggle -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Loaded="AppTitleBar_Loaded" SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140" x:Name="RightPaddingColumn"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                    <Image x:Name="TitleBarIcon" Source="Assets/logo.png" Width="18" Height="18" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Panex" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Width="1" Height="12" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Photon Attenuation &amp; Cross-Section Studio" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="TitleBarUtilitiesPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,8,0">
                <DropDownButton x:Name="DatabaseSelectorButton"
                                Padding="10,4"
                                CornerRadius="14"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Switch Photoatomic Cross-Section Database">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Database:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ActiveDatabaseText" Text="LLNL EPDL (EPICS2025)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem Text="LLNL EPDL (EPICS2025)" x:Name="MenuEpdl" Click="MenuLibrary_Click" IsChecked="True"/>
                            <ToggleMenuFlyoutItem Text="NIST XCOM" x:Name="MenuXcom" Click="MenuLibrary_Click"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button x:Name="ThemeToggleButton"
                        Click="ThemeToggle_Click"
                        Padding="10,4"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Toggle Light / Dark Theme">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE708;" FontSize="12"/>
                        <TextBlock x:Name="ThemeToggleText" Text="Light" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="400" x:Name="SidebarColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Materials List -->
            <Border Grid.Column="0" Margin="8,4,0,8" PointerPressed="MaterialListPanel_PointerPressed" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,8" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="MATERIALS" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                <ToggleButton Content="Compare" IsChecked="{Binding IsCompareMode, Mode=TwoWay}" IsEnabled="{Binding HasMaterials}" Padding="8,4" FontSize="11" FontWeight="SemiBold" CornerRadius="4" ToolTipService.ToolTip="Toggle Multi-Material Comparison Mode" />

                                <Border Width="1" Height="14" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="4,0"/>

                                <Button Click="OpenDrawerNewButton_Click" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Create a new material">
                                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                </Button>
                                <Button Click="OpenDrawerLoadButton_Click" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Load from Library">
                                    <FontIcon Glyph="&#xE838;" FontSize="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView x:Name="MaterialListView" Grid.Row="1" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}" KeyDown="MaterialListView_KeyDown" Background="Transparent" Padding="4,4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Save to Library" Command="{Binding DataContext.SaveMaterialToLibraryCommand, ElementName=RootGrid}" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74E;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Delete" Command="{Binding DataContext.DeleteMaterialCommand, ElementName=RootGrid}" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompared, Mode=TwoWay}" 
                                              Command="{Binding DataContext.ToggleMaterialCompareCommand, ElementName=RootGrid}"
                                              Visibility="{Binding DataContext.IsCompareMode, ElementName=RootGrid, Converter={StaticResource BoolToVisConverter}}"
                                              Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="0,4">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Density, Converter={StaticResource StringFormatConverter}, ConverterParameter='ρ = {0} g/cm³'}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" Visibility="{Binding CanDeleteMaterial, Converter={StaticResource BoolToVisConverter}}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Button Command="{Binding SaveMaterialToLibraryCommand}" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Save to 'My Materials' on disk">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74E;" FontSize="11"/>
                                    <TextBlock Text="Save"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteMaterialCommand}" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Remove from active session">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                    <TextBlock Text="Delete"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <layout:GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Main Content Area -->
            <Grid Grid.Column="2" Margin="0,4,8,8">

                <!-- Empty State -->
                <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85">
                        <Border Width="88" Height="88" CornerRadius="44" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="No material selected" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                        <TextBlock Text="Select a material from the sidebar, or create a new one to get started." HorizontalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Padding="24,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="OpenDrawerNewButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock Text="Create New Material"/>
                                </StackPanel>
                            </Button>

                            <Button Padding="24,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="OpenDrawerLoadButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE838;" FontSize="14"/>
                                    <TextBlock Text="Load from Library"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Active Material / Comparison Content -->
                <Grid Visibility="{Binding ShowMainContent, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Material Header Card & Surfaced Chart Toolbar -->
                    <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,8" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">

                                <StackPanel Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolConverter}}">

                                    <TextBlock Text="{Binding SelectedMaterial.Name}" 
                                               FontSize="22" 
                                               FontWeight="Bold" 
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding SelectedMaterial.Name}"/>

                                    <layout:WrapPanel Orientation="Horizontal" HorizontalSpacing="4" VerticalSpacing="4" Margin="0,4,0,0" VerticalAlignment="Center">

                                        <TextBlock Text="{Binding SelectedMaterial.Density, Converter={StaticResource StringFormatConverter}, ConverterParameter='ρ = {0} g/cm³'}" 
                                                   FontSize="13" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,2,0"/>

                                        <Border Width="1" Height="14" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />

                                        <Button Padding="6,3"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                ToolTipService.ToolTip="View chemical makeup">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE946;" FontSize="12"/>
                                                <TextBlock Text="View Composition"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="MaxWidth" Value="800"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <Border Padding="16" MinWidth="500">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                                <TextBlock Text="Material Composition" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                <Button Command="{Binding CopyCompositionCommand}" HorizontalAlignment="Right" Padding="8,4" FontSize="11">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                                                        <TextBlock Text="Copy to Clipboard"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>

                                                            <dg:DataGrid Grid.Row="1" ItemsSource="{Binding CompositionTable}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                                <dg:DataGrid.Columns>
                                                                    <dg:DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="Auto"/>
                                                                    <dg:DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="Auto"/>
                                                                    <dg:DataGridTextColumn Header="Element" Binding="{Binding Name}" Width="Auto"/>
                                                                    <dg:DataGridTextColumn Header="Atomic Mass (u)" Binding="{Binding AtomicMassString}" Width="Auto"/>
                                                                    <dg:DataGridTextColumn Header="Atom %" Binding="{Binding AtomFractionString}" Width="Auto"/>
                                                                    <dg:DataGridTextColumn Header="Mass %" Binding="{Binding MassFractionString}" Width="Auto"/>
                                                                </dg:DataGrid.Columns>
                                                            </dg:DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <Border Width="1" Height="14" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />

                                        <Button Padding="6,3"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                ToolTipService.ToolTip="View photoelectric X-ray absorption edges">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE945;" FontSize="12"/>
                                                <TextBlock Text="View Absorption Edges"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="MaxWidth" Value="800"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <Border Padding="16" MinWidth="550">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                                <StackPanel>
                                                                    <TextBlock Text="Photoelectric X-Ray Absorption Edges" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Minimum threshold energies required to eject an electron from a specific atomic subshell." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                                <Button Command="{Binding CopyAbsorptionEdgesTableCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4" FontSize="11">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                                                        <TextBlock Text="Copy to Clipboard"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>

                                                            <ListView Grid.Row="1" ItemsSource="{Binding AbsorptionEdgesData}" SelectionMode="None" MaxHeight="400" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                                <ListView.Header>
                                                                    <Grid Padding="12,8" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="80"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Element" FontWeight="SemiBold"/>
                                                                        <TextBlock Grid.Column="1" Text="Subshell" FontWeight="SemiBold"/>
                                                                        <TextBlock Grid.Column="2" Text="Energy (keV)" FontWeight="SemiBold"/>
                                                                        <TextBlock Grid.Column="3" Text="Energy (MeV)" FontWeight="SemiBold"/>
                                                                    </Grid>
                                                                </ListView.Header>
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Padding="0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="100"/>
                                                                                <ColumnDefinition Width="100"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding Element}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Subshell}"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding EnergyKeVString}"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding EnergyMeVString}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </Grid>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </layout:WrapPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Comparison Mode" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Check boxes in the sidebar to add materials to the plot." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                            </Grid>

                            <!-- Right-Aligned Chart Controls Toolbar + Segmented View Switcher -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                <!-- Surfaced Chart Toolbar (Visible when ShowChart is true) -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}">

                                    <ToggleButton Content="Log X"
                                                  IsChecked="{Binding CurrentPlotSettings.IsXLog, Mode=TwoWay}"
                                                  Padding="8,5"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  CornerRadius="6"
                                                  ToolTipService.ToolTip="Toggle Logarithmic X-Axis (Energy)"/>

                                    <ToggleButton Content="Log Y"
                                                  IsChecked="{Binding CurrentPlotSettings.IsYLog, Mode=TwoWay}"
                                                  Padding="8,5"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  CornerRadius="6"
                                                  ToolTipService.ToolTip="Toggle Logarithmic Y-Axis"/>

                                    <ToggleButton x:Name="CrosshairToggleButton"
                                                  IsChecked="{x:Bind _isHoverGlobalEnabled, Mode=OneWay}"
                                                  Click="CrosshairToggleButton_Click"
                                                  Padding="8,5"
                                                  FontSize="11"
                                                  CornerRadius="6"
                                                  ToolTipService.ToolTip="Toggle interactive crosshair &amp; data point inspector (or left-click plot)">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="11"/>
                                            <TextBlock Text="Crosshair" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </ToggleButton>

                                    <Border Width="1" Height="18" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="2,0"/>

                                    <Button x:Name="HiddenSettingsButton"
                                            Padding="8,5"
                                            FontSize="11"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="Configure scales, gridlines, axis limits, and curve styles">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE713;" FontSize="11"/>
                                            <TextBlock Text="Settings" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="MaxWidth" Value="600"/>
                                                        <Setter Property="MaxHeight" Value="600"/>
                                                        <Setter Property="Padding" Value="16,16,28,16"/>
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                                                    <StackPanel Spacing="12" Width="380">
                                                        <TextBlock Text="Chart Settings" FontWeight="Bold" FontSize="16"/>

                                                        <TextBlock Text="Scale" FontWeight="SemiBold"/>
                                                        <ToggleSwitch Header="X-Axis Logarithmic" IsOn="{Binding CurrentPlotSettings.IsXLog, Mode=TwoWay}" />
                                                        <ToggleSwitch Header="Y-Axis Logarithmic" IsOn="{Binding CurrentPlotSettings.IsYLog, Mode=TwoWay}" />

                                                        <TextBlock Text="Grid Lines" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <CheckBox Content="Show Major Grid" IsChecked="{Binding CurrentPlotSettings.ShowMajorGrid, Mode=TwoWay}" />
                                                        <CheckBox Content="Show Minor Grid" IsChecked="{Binding CurrentPlotSettings.ShowMinorGrid, Mode=TwoWay}" />

                                                        <TextBlock Text="Axis Limits" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                                        <CheckBox Content="Custom X Limits" IsChecked="{Binding CurrentPlotSettings.UseCustomXLimits, Mode=TwoWay}" Margin="0,0,0,-6"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBox Header="Min X" Text="{Binding CurrentPlotSettings.XMin, Mode=TwoWay}" Width="110" IsEnabled="{Binding CurrentPlotSettings.UseCustomXLimits}"/>
                                                            <TextBox Header="Max X" Text="{Binding CurrentPlotSettings.XMax, Mode=TwoWay}" Width="110" IsEnabled="{Binding CurrentPlotSettings.UseCustomXLimits}"/>
                                                        </StackPanel>

                                                        <CheckBox Content="Custom Y Limits" IsChecked="{Binding CurrentPlotSettings.UseCustomYLimits, Mode=TwoWay}" Margin="0,8,0,-6"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBox Header="Min Y" Text="{Binding CurrentPlotSettings.YMin, Mode=TwoWay}" Width="110" IsEnabled="{Binding CurrentPlotSettings.UseCustomYLimits}"/>
                                                            <TextBox Header="Max Y" Text="{Binding CurrentPlotSettings.YMax, Mode=TwoWay}" Width="110" IsEnabled="{Binding CurrentPlotSettings.UseCustomYLimits}"/>
                                                        </StackPanel>

                                                        <Button Content="Reset to Defaults" Command="{Binding CurrentPlotSettings.ResetToDefaultsCommand}" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>

                                                        <TextBlock Text="Active Curve Styles" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                                        <ItemsControl ItemsSource="{Binding CurrentPlotSettings.CurveStyles}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding Name}"/>

                                                                        <ComboBox Grid.Column="1" 
                                                                                  ItemsSource="{Binding AvailablePatterns}" 
                                                                                  SelectedItem="{Binding SelectedPattern, Mode=TwoWay}" 
                                                                                  Margin="4,0" 
                                                                                  HorizontalAlignment="Stretch" 
                                                                                  Padding="8,4" 
                                                                                  FontSize="11"
                                                                                  DisplayMemberPath="Name" />

                                                                        <DropDownButton Grid.Column="2" Padding="4" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="0,0,8,0">
                                                                            <DropDownButton.Content>
                                                                                <Border Width="16" Height="16" CornerRadius="8">
                                                                                    <Border.Background>
                                                                                        <SolidColorBrush Color="{Binding UiColor}"/>
                                                                                    </Border.Background>
                                                                                </Border>
                                                                            </DropDownButton.Content>
                                                                            <DropDownButton.Flyout>
                                                                                <Flyout>
                                                                                    <ColorPicker Color="{Binding UiColor, Mode=TwoWay}" IsAlphaEnabled="True" IsColorChannelTextInputVisible="False" IsHexInputVisible="True"/>
                                                                                </Flyout>
                                                                            </DropDownButton.Flyout>
                                                                        </DropDownButton>

                                                                        <NumberBox Grid.Column="3" Width="110" Value="{Binding LineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Inline" Minimum="0.5" Maximum="10" SmallChange="0.5" FontSize="11" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button Click="SaveSvg_Click"
                                            Padding="8,5"
                                            FontSize="11"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="Export active chart to SVG or PNG">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74E;" FontSize="11"/>
                                            <TextBlock Text="Export" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Width="1" Height="18" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="2,0"/>
                                </StackPanel>

                                <!-- Fluent Segmented Pill Control: Chart | Data -->
                                <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="3">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <RadioButton Style="{StaticResource SegmentedPillRadioButtonStyle}"
                                                     GroupName="MainViewModeGroup"
                                                     IsChecked="{Binding ShowChart, Mode=TwoWay}"
                                                     Width="78">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="11"/>
                                                <TextBlock Text="Chart" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentedPillRadioButtonStyle}"
                                                     GroupName="MainViewModeGroup"
                                                     IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                                                     Width="78">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE80A;" FontSize="11"/>
                                                <TextBlock Text="Data" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Physics Tabs -->
                    <TabView x:Name="MainTabView" 
                             Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="Equal" 
                             CanReorderTabs="False" CanDragTabs="False"
                             SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}" 
                             SelectionChanged="OnTabChanged" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                        <!-- Tab 0: Cross Section -->
                        <TabViewItem Header="Cross Section" IsClosable="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="10,6">
                                    <Grid>
                                        <controls:InteractionFiltersControl Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolConverter}}" />
                                        <controls:IncludedInteractionsControl
                                            LabelText="Plot total values based on selected interactions:"
                                            Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisConverter}}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Padding="8" Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}">
                                    <sp:WinUIPlot x:Name="CrossSectionPlot" Loaded="Plot_Loaded" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <controls:PhysicsDataTableControl
                                    Grid.Row="1"
                                    Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisConverter}}"
                                    HeadersSource="{Binding CrossSectionHeaders}"
                                    ItemsSource="{Binding CrossSectionData}"
                                    CopyCommand="{Binding CopyTableToClipboardCommand}" />
                            </Grid>
                        </TabViewItem>

                        <!-- Tab 1: Mass Attenuation -->
                        <TabViewItem Header="Mass Attenuation" IsClosable="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="10,6">
                                    <Grid>
                                        <controls:InteractionFiltersControl Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolConverter}}" />
                                        <controls:IncludedInteractionsControl
                                            LabelText="Plot total values based on selected interactions:"
                                            Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisConverter}}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Padding="8" Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}">
                                    <sp:WinUIPlot x:Name="MacPlot" Loaded="Plot_Loaded" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <controls:PhysicsDataTableControl
                                    Grid.Row="1"
                                    Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisConverter}}"
                                    HeadersSource="{Binding MacHeaders}"
                                    ItemsSource="{Binding MacData}"
                                    CopyCommand="{Binding CopyMacTableToClipboardCommand}" />
                            </Grid>
                        </TabViewItem>

                        <!-- Tab 2: Linear Attenuation -->
                        <TabViewItem Header="Linear Attenuation" IsClosable="False" Visibility="{Binding HasValidDensity, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="10,6">
                                    <Grid>
                                        <controls:InteractionFiltersControl Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolConverter}}" />
                                        <controls:IncludedInteractionsControl
                                            LabelText="Plot total values based on selected interactions:"
                                            Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisConverter}}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Padding="8" Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}">
                                    <sp:WinUIPlot x:Name="LacPlot" Loaded="Plot_Loaded" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <controls:PhysicsDataTableControl
                                    Grid.Row="1"
                                    Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisConverter}}"
                                    HeadersSource="{Binding LacHeaders}"
                                    ItemsSource="{Binding LacData}"
                                    CopyCommand="{Binding CopyLacTableToClipboardCommand}" />
                            </Grid>
                        </TabViewItem>

                        <!-- Tab 3: Depths -->
                        <TabViewItem Header="Depths" IsClosable="False" Visibility="{Binding HasValidDensity, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Calculate Total n-th Value Layer (n): " VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding NValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>

                                        <Border Width="1" Height="20" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="16,0" />

                                        <controls:IncludedInteractionsControl FlyoutTitle="Calculation Components:" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Padding="8" Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}">
                                    <sp:WinUIPlot x:Name="DepthPlot" Loaded="Plot_Loaded" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <controls:PhysicsDataTableControl
                                    Grid.Row="1"
                                    Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisConverter}}"
                                    HeadersSource="{Binding DepthsHeaders}"
                                    ItemsSource="{Binding DepthsData}"
                                    CopyCommand="{Binding CopyDepthsTableToClipboardCommand}" />
                            </Grid>
                        </TabViewItem>

                        <!-- Tab 4: Effective Z -->
                        <TabViewItem Header="Effective Z" IsClosable="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="10,6" MinHeight="48">
                                    <Grid>
                                        <TextBlock Text="Effective Atomic Number (Zeff) vs Energy" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolConverter}}"/>

                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Method:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <RadioButton Content="Direct" IsChecked="{Binding CompareUseInterpolatedZeff, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}" Margin="0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Interpolated" IsChecked="{Binding CompareUseInterpolatedZeff, Mode=TwoWay}" Margin="0" VerticalAlignment="Center"/>

                                            <Border Width="1" Height="20" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="8,0" />

                                            <controls:IncludedInteractionsControl
                                                FlyoutTitle="Included Interactions (Direct Only):"
                                                IsEnabled="{Binding CompareUseInterpolatedZeff, Converter={StaticResource InverseBoolConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Padding="8" Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}">
                                    <sp:WinUIPlot x:Name="ZeffPlot" Loaded="Plot_Loaded" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <controls:PhysicsDataTableControl
                                    Grid.Row="1"
                                    Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisConverter}}"
                                    HeadersSource="{Binding ZeffHeaders}"
                                    ItemsSource="{Binding ZeffData}"
                                    CopyCommand="{Binding CopyZeffTableToClipboardCommand}" />
                            </Grid>
                        </TabViewItem>

                        <!-- Tab 5: Buildup Factors -->
                        <TabViewItem Header="Buildup Factors" IsClosable="False" Visibility="{Binding HasBuildupFactors, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="View Mode:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Exposure (EBF)" IsChecked="{Binding IsEbfMode, Mode=TwoWay}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Energy Absorption (EABF)" IsChecked="{Binding IsEabfMode, Mode=TwoWay}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Equivalent Z (Zeq)" IsChecked="{Binding IsZeqMode, Mode=TwoWay}" VerticalAlignment="Center" Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}"/>
                                        </StackPanel>

                                        <Border Width="1" Height="20" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="8,0" />

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Target Depths (MFP):" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding TargetMfpInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" VerticalAlignment="Center" IsEnabled="{Binding IsZeqMode, Converter={StaticResource InverseBoolConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Padding="8" Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid>
                                        <Grid Visibility="{Binding IsBuildupPlotActive, Converter={StaticResource BoolToVisConverter}}">
                                            <sp:WinUIPlot x:Name="BuildupPlot" Loaded="Plot_Loaded" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Grid>
                                        <Grid Visibility="{Binding IsBuildupPlotActive, Converter={StaticResource InverseBoolConverter}}">
                                            <sp:WinUIPlot x:Name="ZeqPlot" Loaded="Plot_Loaded" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <controls:PhysicsDataTableControl
                                    Grid.Row="1"
                                    Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisConverter}}"
                                    ShowEnergyGridConfig="False"
                                    HeadersSource="{Binding BuildupHeaders}"
                                    ItemsSource="{Binding BuildupData}"
                                    CopyCommand="{Binding CopyBuildupTableToClipboardCommand}" />
                            </Grid>
                        </TabViewItem>

                    </TabView>
                </Grid>

                <!-- Loading Overlay -->
                <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" Canvas.ZIndex="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <ProgressRing IsActive="{Binding IsLoading}" Width="60" Height="60" />
                        <TextBlock Text="Calculating Physics Data..." FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Drawer Scrim -->
        <Border x:Name="DrawerScrim" Grid.Row="1" Background="Black" Opacity="0" IsHitTestVisible="False" PointerPressed="DrawerScrim_PointerPressed"/>

        <!-- Unified Add / Load Material Drawer -->
        <Border x:Name="CreateDrawer" Grid.Row="1" HorizontalAlignment="Right" Width="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Thumb Grid.Column="0" Width="10" DragDelta="DrawerDragHandle_DragDelta" Background="Transparent" ToolTipService.ToolTip="Drag to resize drawer">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}">
                                <Border Width="3" Height="36" VerticalAlignment="Center" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="1.5"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <Border x:Name="DrawerContent" Grid.Column="1" Opacity="0" Padding="24,20,24,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Drawer Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Material Composer" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Click="CloseDrawerButton_Click" HorizontalAlignment="Right" Padding="8" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Close Drawer (Esc)">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <!-- Unified Mode Switcher: Browse Library vs Create Custom -->
                        <Border Grid.Row="1"
                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Margin="0,0,12,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             Style="{StaticResource SegmentedPillRadioButtonStyle}"
                                             GroupName="DrawerModeGroup"
                                             IsChecked="{Binding IsLoadMode, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE838;" FontSize="13"/>
                                        <TextBlock Text="Browse Library" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Grid.Column="1"
                                             Style="{StaticResource SegmentedPillRadioButtonStyle}"
                                             GroupName="DrawerModeGroup"
                                             IsChecked="{Binding IsCreateMode, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                        <TextBlock Text="Create Custom" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>

                        <!-- Drawer Body -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <Grid>
                                <!-- Mode 1: Browse Library -->
                                <StackPanel Visibility="{Binding IsLoadMode, Converter={StaticResource BoolToVisConverter}}">
                                    <TabView SelectedIndex="{Binding SelectedLoadTabIndex, Mode=TwoWay}" IsAddTabButtonVisible="False" TabWidthMode="Equal" Margin="0,0,0,8">
                                        <TabViewItem Header="Standard Library" IsClosable="False" />
                                        <TabViewItem Header="Custom Materials" IsClosable="False" />
                                    </TabView>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding IsNotRenamingCustomMaterial, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <FontIcon Glyph="&#xE721;" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Canvas.ZIndex="1" IsHitTestVisible="False" FontSize="12"/>
                                                <TextBox Text="{Binding LibrarySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search materials by name..." Padding="30,6,8,6"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" Spacing="4" Visibility="{Binding ShowCustomMaterials, Converter={StaticResource BoolToVisConverter}}">
                                                <Button Command="{Binding BeginRenameCustomMaterialCommand}" Padding="8,6" ToolTipService.ToolTip="Rename custom material">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                                </Button>
                                                <Button Command="{Binding DeleteLibraryMaterialCommand}" CommandParameter="{Binding SelectedLibraryMaterial}" Padding="8,6" ToolTipService.ToolTip="Delete custom material">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding IsRenamingCustomMaterial, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SelectedLibraryMaterial.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" Spacing="4">
                                                <Button Command="{Binding SaveCustomMaterialNameCommand}" Padding="10,5" FontSize="11" Style="{ThemeResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE74E;" FontSize="11"/>
                                                        <TextBlock Text="Save"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding CancelRenameCustomMaterialCommand}" Padding="10,5" FontSize="11">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE711;" FontSize="11"/>
                                                        <TextBlock Text="Cancel"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <dg:DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLibrary}"
                                            SelectedItem="{Binding SelectedLibraryMaterial, Mode=TwoWay}"
                                            AutoGenerateColumns="False" IsReadOnly="True"
                                            SelectionMode="Single" HeadersVisibility="Column"
                                            GridLinesVisibility="Horizontal" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                                            BorderThickness="1" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowBackground="Transparent"
                                            CanUserSortColumns="True" Sorting="LibraryDataGrid_Sorting">
                                            <dg:DataGrid.Columns>
                                                <dg:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="200" Tag="Name" />
                                                <dg:DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto" MinWidth="120" Tag="Category" />
                                                <dg:DataGridTextColumn Header="Density (g/cm³)" Binding="{Binding Density, TargetNullValue='-'}" Width="Auto" MinWidth="130" Tag="Density">
                                                    <dg:DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                                        </Style>
                                                    </dg:DataGridTextColumn.ElementStyle>
                                                </dg:DataGridTextColumn>
                                                <dg:DataGridTextColumn Header="Source" Binding="{Binding Reference}" Width="Auto" MinWidth="120" Tag="Reference">
                                                    <dg:DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabled}"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Margin" Value="4,0"/>
                                                            <Setter Property="ToolTipService.ToolTip" Value="{Binding Citation}" />
                                                        </Style>
                                                    </dg:DataGridTextColumn.ElementStyle>
                                                </dg:DataGridTextColumn>
                                            </dg:DataGrid.Columns>
                                        </dg:DataGrid>

                                        <StackPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding HasSelectedLibraryMaterial, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid Margin="0,8,0,4">
                                                <TextBlock Text="Composition (Atom Fraction):" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                <Button Command="{Binding CopyPreviewCompositionCommand}" HorizontalAlignment="Right" Padding="6,3" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Copy composition to clipboard">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                                        <TextBlock Text="Copy"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                                <ItemsControl ItemsSource="{Binding PreviewCompositionTable}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                <TextBlock Text="{Binding Symbol}" Width="35" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding FractionText}" Foreground="{ThemeResource TextFillColorSecondary}" FontSize="11"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Density Override (g/cm³)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding MaterialDensityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="Leave as default or enter a custom density."/>
                                </StackPanel>

                                <!-- Mode 2: Create Custom Material -->
                                <StackPanel Visibility="{Binding IsLoadMode, Converter={StaticResource InverseBoolConverter}}">
                                    <TabView SelectedIndex="{Binding SelectedInputTabIndex, Mode=TwoWay}" IsAddTabButtonVisible="False" TabWidthMode="Equal" Margin="0,0,0,20">
                                        <TabViewItem Header="Element" IsClosable="False">
                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="Select or Filter Element" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                                <!-- Quick Element Search / Filter Box by Symbol, Name, or Z -->
                                                <Grid Margin="0,0,0,8">
                                                    <FontIcon Glyph="&#xE721;" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Canvas.ZIndex="1" IsHitTestVisible="False" FontSize="12"/>
                                                    <TextBox Text="{Binding ElementSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="Filter by symbol, name, or atomic number Z (e.g. Fe, Iron, 26)..."
                                                             Padding="30,6,8,6"/>
                                                </Grid>

                                                <ComboBox ItemsSource="{Binding FilteredElements}" SelectedItem="{Binding SelectedElementInput, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Z}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="1">
                                                                    <Run Text="{Binding Symbol}" FontWeight="Bold"/>
                                                                    <Run Text=" - "/>
                                                                    <Run Text="{Binding Name}"/>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <StackPanel Visibility="{Binding IsElementSelected, Converter={StaticResource BoolToVisConverter}}" Margin="0,20,0,0">

                                                    <TextBlock Text="Average Atomic Mass" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedElementInput.AtomicMass, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:0.##########} u'}" IsTextSelectionEnabled="True" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,16"/>
                                                    
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="Natural Isotopes" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <Button Command="{Binding CopyIsotopesCommand}" HorizontalAlignment="Right" Padding="6,3" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Copy table to clipboard">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                                                <TextBlock Text="Copy"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <ListView ItemsSource="{Binding SelectedElementInput.Isotopes}" SelectionMode="None" MaxHeight="220" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                        <ListView.Header>
                                                            <Grid Padding="12,6" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="A" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Grid.Column="1" Text="Mass (u)" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Grid.Column="2" Text="Abundance" FontWeight="SemiBold" FontSize="11"/>
                                                            </Grid>
                                                        </ListView.Header>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Padding="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding A}" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Mass, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:0.#################}'}" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Abundance, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:0.######%}'}" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="MinHeight" Value="28"/>
                                                                <Setter Property="Padding" Value="12,0"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListViewItem">
                                                                            <ListViewItemPresenter ContentMargin="{TemplateBinding Padding}" SelectedBackground="Transparent" PointerOverBackground="Transparent" PressedBackground="Transparent" />
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                    </ListView>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabViewItem>
                                        <TabViewItem Header="Compound" IsClosable="False">
                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="Chemical Formula" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding CompoundFormulaInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="e.g. H2O, UO2, NaCl"/>
                                            </StackPanel>
                                        </TabViewItem>
                                        <TabViewItem Header="Mixture" IsClosable="False">
                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="Mixture Components" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding MixtureInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                                <TextBlock Text="Fraction Type" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <RadioButton Content="Atom Fraction" 
                                                                 IsChecked="{Binding IsMixtureByWeight, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"/>
                                                    <RadioButton Content="Weight (Mass) Fraction" 
                                                                 IsChecked="{Binding IsMixtureByWeight, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabViewItem>
                                    </TabView>

                                    <Border BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Material Profile" FontWeight="Bold" Margin="0,0,0,12"/>

                                            <TextBlock Text="Name" Margin="0,0,0,4" 
                                                Visibility="{Binding IsMixtureMode, Converter={StaticResource BoolToVisConverter}}"/>

                                            <TextBox Text="{Binding MaterialNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" 
                                                Visibility="{Binding IsMixtureMode, Converter={StaticResource BoolToVisConverter}}"/>

                                            <TextBlock Text="Density (g/cm³)" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding MaterialDensityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="Leave blank to auto-calculate if possible"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Drawer Footer Action Buttons -->
                        <Grid Grid.Row="3" Margin="0,16,0,0" Padding="0,16,12,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                            <Button Command="{Binding CreateMaterialCommand}" Click="CreateMaterial_Click" 
                                    Style="{ThemeResource AccentButtonStyle}"
                                    FontWeight="Bold" Padding="12,12" HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsLoadMode, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE838;" FontSize="14"/>
                                    <TextBlock Text="Load Selected Material"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CreateMaterialCommand}" Click="CreateMaterial_Click" 
                                    Style="{ThemeResource AccentButtonStyle}"
                                    FontWeight="Bold" Padding="12,12" HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsLoadMode, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock Text="Create Material"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Plot Hover Crosshair Tooltip Canvas -->
        <Canvas Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Canvas.ZIndex="1000">
            <Border x:Name="HoverTooltip" 
                    Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel x:Name="HoverContentPanel" Spacing="6">
                    <TextBlock x:Name="HoverHeader" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <Border Height="1" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="0,4"/>
                    <ItemsControl x:Name="HoverItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueString}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</winuiex:WindowEx>
